{
  "name": "LibraSphere Development Environment",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
  "forwardPorts": [5173, 3001],
  "portsAttributes": {
    "5173": {
      "label": "LibraSphere Frontend (Client)",
      "onAutoForward": "openBrowser"
    },
    "3001": {
      "label": "LibraSphere Backend API (Express)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "npm install && npm run prisma:generate --workspace=server && npm run prisma:push --workspace=server && npm run seed && npm run build",
  "postAttachCommand": "npm run dev"
}
